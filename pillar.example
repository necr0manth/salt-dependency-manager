# -*- coding: utf-8 -*-
# vim: ft=yaml
---
salt_dependency_manager:
  schema: 1
  saltenv: example
  sides: [minion]
  install_path: /root
  repository_order: [project, salt_lib]
  repositories:
    project:
      source: local
      path: /root/project
      state_roots: ['.']
      pillar_roots: []
    salt_lib:
      source: git
      url: git@github.com:necr0manth/salt-lib.git
      ref: 547c56d52c756a941d64c22bf98d7d038fcc88ac
      state_roots: ['.']
      pillar_roots: []
