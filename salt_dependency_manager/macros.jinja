{#- Schema-1 dependency renderer. The compiled pillar mapping is its only input. #}

{%- macro render_manager(config) -%}
{%- if config is not mapping %}
{%- do raise('salt-dependency-manager: salt_dependency_manager must be a mapping') %}
{%- endif %}
{%- if config.get('schema') != 1 %}
{%- do raise('salt-dependency-manager: schema must be 1') %}
{%- endif %}

{%- set saltenv = config.get('saltenv') %}
{%- if saltenv is not string or not (saltenv|regex_match('^[A-Za-z0-9][A-Za-z0-9_.-]*$')) %}
{%- do raise('salt-dependency-manager: saltenv must match ^[A-Za-z0-9][A-Za-z0-9_.-]*$') %}
{%- endif %}

{%- set sides = config.get('sides') %}
{%- if sides is string or sides is mapping or sides is not iterable or not sides %}
{%- do raise('salt-dependency-manager: sides must be a non-empty list') %}
{%- endif %}
{%- set normalized_sides = [] %}
{%- for side in sides %}
{%- if side is not string or side not in ['minion', 'master'] %}
{%- do raise("salt-dependency-manager: sides entries must be 'minion' or 'master'") %}
{%- endif %}
{%- if side in normalized_sides %}
{%- do raise('salt-dependency-manager: sides entries must be unique') %}
{%- endif %}
{%- do normalized_sides.append(side) %}
{%- endfor %}

{%- set repositories = config.get('repositories') %}
{%- if repositories is not mapping or not repositories %}
{%- do raise('salt-dependency-manager: repositories must be a non-empty mapping') %}
{%- endif %}
{%- set repository_order = config.get('repository_order') %}
{%- if repository_order is string or repository_order is mapping or repository_order is not iterable or not repository_order %}
{%- do raise('salt-dependency-manager: repository_order must be a non-empty list') %}
{%- endif %}
{%- set seen_order = [] %}
{%- for repository_id in repository_order %}
{%- if repository_id is not string %}
{%- do raise('salt-dependency-manager: repository_order entries must be strings') %}
{%- endif %}
{%- if repository_id in seen_order %}
{%- do raise('salt-dependency-manager: repository_order entries must be unique') %}
{%- endif %}
{%- if repository_id not in repositories %}
{%- do raise("salt-dependency-manager: repository_order contains unknown repository '" ~ repository_id ~ "'") %}
{%- endif %}
{%- do seen_order.append(repository_id) %}
{%- endfor %}
{%- if seen_order|length != repositories|length %}
{%- do raise('salt-dependency-manager: repository_order must contain every repository exactly once') %}
{%- endif %}

{%- set install_path = config.get('install_path') %}
{%- if install_path is not none and (install_path is not string or not install_path.startswith('/')) %}
{%- do raise('salt-dependency-manager: install_path must be an absolute path') %}
{%- endif %}

{%- set normalized_repositories = [] %}
{%- set canonical_paths = [] %}
{%- set file_roots = [] %}
{%- set pillar_roots = [] %}
{%- set git_repository_ids = [] %}
{%- set owned_git_options = ['name', 'target', 'rev', 'update_head', 'require'] %}

{%- for repository_id in repository_order %}
{%- if not (repository_id|regex_match('^[A-Za-z0-9][A-Za-z0-9_.-]*$')) %}
{%- do raise("salt-dependency-manager: unsafe repository ID '" ~ repository_id ~ "'") %}
{%- endif %}
{%- set repository = repositories.get(repository_id) %}
{%- if repository is not mapping %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' must be a mapping") %}
{%- endif %}
{%- set source = repository.get('source') %}
{%- if source not in ['local', 'git'] %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' source must be local or git") %}
{%- endif %}
{%- set ref = repository.get('ref', 'HEAD') %}
{%- if ref is not string or not ref %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' ref must be a non-empty string") %}
{%- endif %}
{%- set update = repository.get('update', true) %}
{%- if update is not sameas true and update is not sameas false %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' update must be boolean") %}
{%- endif %}
{%- set git_options = repository.get('git_options', {}) %}
{%- if git_options is not mapping %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' git_options must be a mapping") %}
{%- endif %}
{%- for option_name in git_options %}
{%- if option_name is not string or not option_name %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' git_options keys must be non-empty strings") %}
{%- endif %}
{%- if option_name in owned_git_options %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' git_options may not override manager-owned option '" ~ option_name ~ "'") %}
{%- endif %}
{%- endfor %}

{%- if source == 'local' %}
{%- set repository_path = repository.get('path') %}
{%- if repository_path is not string or not repository_path.startswith('/') %}
{%- do raise("salt-dependency-manager: local repository '" ~ repository_id ~ "' requires an absolute path") %}
{%- endif %}
{%- if not salt['file.directory_exists'](repository_path) %}
{%- do raise("salt-dependency-manager: local repository '" ~ repository_id ~ "' path does not exist") %}
{%- endif %}
{%- set realpath_result = salt['cmd.run_all'](['realpath', '-e', '--', repository_path], python_shell=false) %}
{%- if realpath_result.get('retcode') != 0 %}
{%- do raise("salt-dependency-manager: cannot resolve local repository '" ~ repository_id ~ "' path") %}
{%- endif %}
{%- set canonical_repository_path = realpath_result.get('stdout') %}
{%- set url = none %}
{%- else %}
{%- set url = repository.get('url') %}
{%- if url is not string or not url|trim %}
{%- do raise("salt-dependency-manager: git repository '" ~ repository_id ~ "' requires a non-empty url") %}
{%- endif %}
{%- set repository_path = repository.get('path') %}
{%- if repository_path is not none %}
{%- if repository_path is not string or not repository_path.startswith('/') %}
{%- do raise("salt-dependency-manager: git repository '" ~ repository_id ~ "' path must be absolute") %}
{%- endif %}
{%- else %}
{%- if install_path is not string or not install_path.startswith('/') %}
{%- do raise("salt-dependency-manager: git repository '" ~ repository_id ~ "' requires an absolute install_path") %}
{%- endif %}
{%- set clean_url = url|trim %}
{%- set clean_url = clean_url[:-1] if clean_url.endswith('/') else clean_url %}
{%- set repository_name = clean_url.split('/')[-1] %}
{%- set repository_name = repository_name[:-4] if repository_name.endswith('.git') else repository_name %}
{%- if not repository_name or not (repository_name|regex_match('^[A-Za-z0-9][A-Za-z0-9_.-]*$')) %}
{%- do raise("salt-dependency-manager: git repository '" ~ repository_id ~ "' URL has an unsafe repository basename") %}
{%- endif %}
{%- set repository_path = install_path.rstrip('/') ~ '/' ~ repository_name %}
{%- endif %}
{%- set realpath_result = salt['cmd.run_all'](['realpath', '-m', '--', repository_path], python_shell=false) %}
{%- if realpath_result.get('retcode') != 0 %}
{%- do raise("salt-dependency-manager: cannot resolve git repository '" ~ repository_id ~ "' target") %}
{%- endif %}
{%- set canonical_repository_path = realpath_result.get('stdout') %}
{%- do git_repository_ids.append(repository_id) %}
{%- endif %}

{%- if canonical_repository_path in canonical_paths %}
{%- do raise("salt-dependency-manager: canonical repository path collision at '" ~ canonical_repository_path ~ "'") %}
{%- endif %}
{%- do canonical_paths.append(canonical_repository_path) %}

{%- set normalized_state_roots = [] %}
{%- set normalized_pillar_roots = [] %}
{%- for root_kind, declared_roots, output_roots in [
  ('state_roots', repository.get('state_roots', ['.']), normalized_state_roots),
  ('pillar_roots', repository.get('pillar_roots', ['pillar']), normalized_pillar_roots)
] %}
{%- if declared_roots is string or declared_roots is mapping or declared_roots is not iterable %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' " ~ root_kind ~ ' must be a list') %}
{%- endif %}
{%- for declared_root in declared_roots %}
{%- if declared_root is not string or not declared_root %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' " ~ root_kind ~ ' entries must be non-empty strings') %}
{%- endif %}
{%- if declared_root.startswith('/') or '..' in declared_root.split('/') %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' " ~ root_kind ~ " entries must be relative and may not contain '..'") %}
{%- endif %}
{%- set normalized_root = salt['file.normpath'](declared_root) %}
{%- if normalized_root.startswith('/') or normalized_root == '..' or normalized_root.startswith('../') %}
{%- do raise("salt-dependency-manager: repository '" ~ repository_id ~ "' " ~ root_kind ~ ' entry escapes the repository') %}
{%- endif %}
{%- set normalized_root = '.' if normalized_root == '.' else normalized_root %}
{%- do output_roots.append(normalized_root) %}
{%- set absolute_root = canonical_repository_path if normalized_root == '.' else canonical_repository_path.rstrip('/') ~ '/' ~ normalized_root %}
{%- if source == 'local' %}
{%- if not salt['file.directory_exists'](absolute_root) %}
{%- do raise("salt-dependency-manager: local repository '" ~ repository_id ~ "' declared root does not exist: " ~ normalized_root) %}
{%- endif %}
{%- set root_realpath_result = salt['cmd.run_all'](['realpath', '-e', '--', absolute_root], python_shell=false) %}
{%- if root_realpath_result.get('retcode') != 0 %}
{%- do raise("salt-dependency-manager: cannot resolve local repository '" ~ repository_id ~ "' root: " ~ normalized_root) %}
{%- endif %}
{%- set canonical_root = root_realpath_result.get('stdout') %}
{%- if canonical_root != canonical_repository_path and not canonical_root.startswith(canonical_repository_path.rstrip('/') ~ '/') %}
{%- do raise("salt-dependency-manager: local repository '" ~ repository_id ~ "' root escapes through a symlink: " ~ normalized_root) %}
{%- endif %}
{%- endif %}
{%- if root_kind == 'state_roots' and absolute_root not in file_roots %}
{%- do file_roots.append(absolute_root) %}
{%- elif root_kind == 'pillar_roots' and absolute_root not in pillar_roots %}
{%- do pillar_roots.append(absolute_root) %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- do normalized_repositories.append({
  'id': repository_id,
  'source': source,
  'path': repository_path,
  'canonical_path': canonical_repository_path,
  'url': url,
  'ref': ref,
  'update': update,
  'git_options': git_options,
  'state_roots': normalized_state_roots,
  'pillar_roots': normalized_pillar_roots
}) %}
{%- endfor %}

{%- if git_repository_ids %}
salt_dependency_manager_git:
  pkg.installed:
    - name: git

{%- endif %}
{%- for repository in normalized_repositories if repository.source == 'git' %}
salt_dependency_manager_repository_{{ repository.id }}:
  git.latest:
    - name: {{ repository.url|json }}
    - target: {{ repository.path|json }}
    - rev: {{ repository.ref|json }}
    - update_head: {{ repository['update']|yaml }}
{%- for option_name, option_value in repository.git_options.items() %}
    - {{ option_name|json }}: {{ option_value|json }}
{%- endfor %}
    - require:
      - pkg: salt_dependency_manager_git

{%- for root_kind, roots in [('state', repository.state_roots), ('pillar', repository.pillar_roots)] %}
{%- for root in roots %}
salt_dependency_manager_{{ repository.id }}_{{ root_kind }}_root_{{ loop.index }}:
  module.run:
    - cmd.run_all:
      - cmd:
        - python3
        - -c
        - |
            import os
            import sys
            repository = os.path.realpath(sys.argv[1])
            root = os.path.realpath(os.path.join(repository, sys.argv[2]))
            valid = os.path.isdir(root) and (root == repository or root.startswith(repository + os.sep))
            raise SystemExit(0 if valid else 1)
        - {{ repository.path|json }}
        - {{ root|json }}
      - python_shell: false
    - require:
      - git: salt_dependency_manager_repository_{{ repository.id }}

{%- endfor %}
{%- endfor %}
{%- endfor %}

{%- for side in ['minion', 'master'] %}
{%- set config_path = '/etc/salt/' ~ side ~ '.d/50-salt-dependency-manager-' ~ saltenv ~ '.conf' %}
{%- if side in normalized_sides %}
salt_dependency_manager_{{ side }}_config_directory:
  file.directory:
    - name: {{ ('/etc/salt/' ~ side ~ '.d')|json }}
    - makedirs: true
{%- if git_repository_ids %}
    - require:
      - pkg: salt_dependency_manager_git
{%- for repository in normalized_repositories if repository.source == 'git' %}
      - git: salt_dependency_manager_repository_{{ repository.id }}
{%- for root_kind, roots in [('state', repository.state_roots), ('pillar', repository.pillar_roots)] %}
{%- for root in roots %}
      - module: salt_dependency_manager_{{ repository.id }}_{{ root_kind }}_root_{{ loop.index }}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- endif %}

salt_dependency_manager_{{ side }}_config:
  file.managed:
    - name: {{ config_path|json }}
    - contents: |
        # This file is managed by Salt dependency manager.
        file_roots:
          {{ saltenv|json }}:
{%- if file_roots %}
{%- for root in file_roots %}
            - {{ root|json }}
{%- endfor %}
{%- else %}
            []
{%- endif %}
        pillar_roots:
          {{ saltenv|json }}:
{%- if pillar_roots %}
{%- for root in pillar_roots %}
            - {{ root|json }}
{%- endfor %}
{%- else %}
            []
{%- endif %}
    - require:
      - file: salt_dependency_manager_{{ side }}_config_directory
{%- if git_repository_ids %}
      - pkg: salt_dependency_manager_git
{%- for repository in normalized_repositories if repository.source == 'git' %}
      - git: salt_dependency_manager_repository_{{ repository.id }}
{%- for root_kind, roots in [('state', repository.state_roots), ('pillar', repository.pillar_roots)] %}
{%- for root in roots %}
      - module: salt_dependency_manager_{{ repository.id }}_{{ root_kind }}_root_{{ loop.index }}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- else %}
salt_dependency_manager_{{ side }}_config_absent:
  file.absent:
    - name: {{ config_path|json }}

{%- endif %}
{%- endfor %}
{%- endmacro %}
