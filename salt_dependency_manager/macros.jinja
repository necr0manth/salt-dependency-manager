{#-
Salt dependency manager helpers.

The public macro is dependency(). It returns a normalized YAML mapping so it can
be used from pillar, custom states, or this formula's pillar-driven state.
-#}

{%- set default_path = '/root' %}
{%- set default_ref = 'master' %}
{%- set default_env = 'base' %}

{%- macro _as_bool(value, default=True) -%}
{%- if value is none -%}
{{ default|yaml }}
{%- elif value is sameas true or value is sameas false -%}
{{ value|yaml }}
{%- elif value|string|lower in ['true', 'yes', 'on', '1'] -%}
true
{%- elif value|string|lower in ['false', 'no', 'off', '0'] -%}
false
{%- else -%}
{{ default|yaml }}
{%- endif -%}
{%- endmacro %}

{%- macro _repo_name(url) -%}
{%- set clean_url = url|string|trim|replace('\\', '/') %}
{%- set clean_url = clean_url[:-1] if clean_url.endswith('/') else clean_url %}
{{ clean_url.split('/')[-1].replace('.git', '') }}
{%- endmacro %}

{%- macro _id(value) -%}
{{ value|string|lower
  |replace('://', '_')
  |replace(':', '_')
  |replace('/', '_')
  |replace('\\', '_')
  |replace('.', '_')
  |replace('-', '_')
  |replace('@', '_')
  |replace(' ', '_') }}
{%- endmacro %}

{%- macro _sides(value) -%}
{%- if value is string %}
{%- set result = [value] %}
{%- elif value is iterable and value is not mapping %}
{%- set result = value|list %}
{%- else %}
{%- set result = value %}
{%- endif %}
{{ result|yaml }}
{%- endmacro %}

{%- macro dependency(
    url,
    sides='minion',
    pillar=True,
    path=default_path,
    gitfs=False,
    ref=default_ref,
    version=None,
    name=None,
    env=default_env,
    root=None,
    pillar_root='pillar',
    update=True,
    options=None
) -%}
{%- set dep_name = name or (_repo_name(url)|trim) %}
{%- set dep_root = root or path.rstrip('/') ~ '/' ~ dep_name %}
{%- set dep = {
  'id': _id(url ~ '_' ~ dep_name)|trim,
  'name': dep_name,
  'url': url,
  'sides': _sides(sides)|load_yaml,
  'pillar': _as_bool(pillar, True)|load_yaml,
  'path': path,
  'gitfs': _as_bool(gitfs, False)|load_yaml,
  'ref': version or ref,
  'env': env,
  'root': dep_root,
  'pillar_root': pillar_root,
  'update': _as_bool(update, True)|load_yaml,
  'options': options or {},
} %}
{{ dep|yaml }}
{%- endmacro %}

{%- macro dependency_from_pillar(entry) -%}
{%- if entry is string %}
{{ dependency(entry) }}
{%- elif 'url' in entry %}
{{ dependency(
  entry.get('url'),
  sides=entry.get('sides', entry.get('side', 'minion')),
  pillar=entry.get('pillar', True),
  path=entry.get('path', default_path),
  gitfs=entry.get('gitfs', False),
  ref=entry.get('ref', entry.get('rev', entry.get('branch', default_ref))),
  version=entry.get('version'),
  name=entry.get('name'),
  env=entry.get('env', default_env),
  root=entry.get('root'),
  pillar_root=entry.get('pillar_root', 'pillar'),
  update=entry.get('update', True),
  options=entry.get('options', {})
) }}
{%- else %}
{%- set url = entry|first %}
{%- set opts = entry[url] or {} %}
{{ dependency(
  url,
  sides=opts.get('sides', opts.get('side', 'minion')),
  pillar=opts.get('pillar', True),
  path=opts.get('path', default_path),
  gitfs=opts.get('gitfs', False),
  ref=opts.get('ref', opts.get('rev', opts.get('branch', default_ref))),
  version=opts.get('version'),
  name=opts.get('name'),
  env=opts.get('env', default_env),
  root=opts.get('root'),
  pillar_root=opts.get('pillar_root', 'pillar'),
  update=opts.get('update', True),
  options=opts.get('options', {})
) }}
{%- endif %}
{%- endmacro %}

{%- macro config_for_side(side, dependencies, file_roots=None, pillar_roots=None) -%}
# This file is managed by Salt dependency manager.
{%- if side == 'minion' %}
file_client: local
{%- endif %}
{%- set local_file_roots = {} %}
{%- set local_pillar_roots = {} %}
{%- set gitfs_remotes = [] %}
{%- set git_pillars = [] %}
{%- set extra_file_roots = [file_roots] if file_roots is string else (file_roots or []) %}
{%- set extra_pillar_roots = [pillar_roots] if pillar_roots is string else (pillar_roots or []) %}
{%- for root in extra_file_roots %}
{%- if default_env not in local_file_roots %}
{%- do local_file_roots.update({default_env: []}) %}
{%- endif %}
{%- if root not in local_file_roots[default_env] %}
{%- do local_file_roots[default_env].append(root) %}
{%- endif %}
{%- endfor %}
{%- for root in extra_pillar_roots %}
{%- if default_env not in local_pillar_roots %}
{%- do local_pillar_roots.update({default_env: []}) %}
{%- endif %}
{%- if root not in local_pillar_roots[default_env] %}
{%- do local_pillar_roots[default_env].append(root) %}
{%- endif %}
{%- endfor %}
{%- for dep in dependencies if side in dep.sides %}
{%- if dep.gitfs %}
{%- do gitfs_remotes.append(dep) %}
{%- if dep.pillar %}
{%- do git_pillars.append(dep) %}
{%- endif %}
{%- else %}
{%- if dep.env not in local_file_roots %}
{%- do local_file_roots.update({dep.env: []}) %}
{%- endif %}
{%- do local_file_roots[dep.env].append(dep.root) %}
{%- if dep.pillar %}
{%- if dep.env not in local_pillar_roots %}
{%- do local_pillar_roots.update({dep.env: []}) %}
{%- endif %}
{%- do local_pillar_roots[dep.env].append(dep.root ~ '/' ~ dep.pillar_root) %}
{%- endif %}
{%- endif %}
{%- endfor %}

{%- if local_file_roots %}
file_roots:
{%- for env, roots in local_file_roots|dictsort %}
  {{ env }}:
{%- for root in roots %}
    - {{ root }}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- if local_pillar_roots %}
pillar_roots:
{%- for env, roots in local_pillar_roots|dictsort %}
  {{ env }}:
{%- for root in roots %}
    - {{ root }}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- if gitfs_remotes %}
fileserver_backend:
  - roots
  - git

gitfs_remotes:
{%- for dep in gitfs_remotes %}
  - {{ dep.url }}:
    - {{ dep.env }}: {{ dep.ref }}
{%- for key, value in dep.options.items() %}
    - {{ key }}: {{ value|json }}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- if git_pillars %}
ext_pillar:
  - git:
{%- for dep in git_pillars %}
    - {{ dep.ref }} {{ dep.url }}:
      - env: {{ dep.env }}
      - root: {{ dep.pillar_root }}
{%- for key, value in dep.options.items() %}
      - {{ key }}: {{ value|json }}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- endmacro %}

{%- macro manage_dependencies(
    dependencies,
    config_name=None,
    config_basename=None,
    file_roots=None,
    pillar_roots=None,
    target_sides=None
) -%}
{%- set config_id = _id(config_name or 'default')|trim %}
{%- set conf_name = config_basename or 'salt-dependency-manager' ~ ('-' ~ config_id if config_name else '') %}

{# Validate and normalize every dependency before emitting any state blocks. #}
{%- if dependencies is string or dependencies is mapping or dependencies is not iterable %}
{%- do raise('salt-dependency-manager: dependencies must be an iterable of dependency mappings') %}
{%- endif %}
{%- set all_dependency_sides = [] %}
{%- for dep in dependencies %}
{%- if dep is not mapping %}
{%- do raise('salt-dependency-manager: dependency #' ~ loop.index ~ ' must be a mapping') %}
{%- endif %}
{%- if 'sides' not in dep %}
{%- do raise('salt-dependency-manager: dependency #' ~ loop.index ~ ' is missing sides') %}
{%- endif %}
{%- set raw_dep_sides = dep.sides %}
{%- if raw_dep_sides is string %}
{%- set normalized_dep_sides = [raw_dep_sides] %}
{%- elif raw_dep_sides is mapping or raw_dep_sides is not iterable %}
{%- do raise('salt-dependency-manager: dependency #' ~ loop.index ~ ' sides must be a string or iterable') %}
{%- else %}
{%- set normalized_dep_sides = raw_dep_sides|list %}
{%- endif %}
{%- set unique_dep_sides = [] %}
{%- for side in normalized_dep_sides %}
{%- if side is not string or side not in ['minion', 'master'] %}
{%- do raise("salt-dependency-manager: invalid dependency.sides value '" ~ side|string ~ "'; expected 'minion' or 'master'") %}
{%- endif %}
{%- if side not in unique_dep_sides %}
{%- do unique_dep_sides.append(side) %}
{%- endif %}
{%- if side not in all_dependency_sides %}
{%- do all_dependency_sides.append(side) %}
{%- endif %}
{%- endfor %}
{%- do dep.update({'sides': unique_dep_sides}) %}
{%- endfor %}

{# target_sides selects this invocation; dependency.sides remains applicability. #}
{%- if target_sides is none %}
{%- set requested_side_values = all_dependency_sides %}
{%- elif target_sides is string %}
{%- set requested_side_values = [target_sides] %}
{%- elif target_sides is mapping or target_sides is not iterable %}
{%- do raise('salt-dependency-manager: target_sides must be a string or iterable') %}
{%- else %}
{%- set requested_side_values = target_sides|list %}
{%- if not requested_side_values %}
{%- do raise('salt-dependency-manager: target_sides must not be empty') %}
{%- endif %}
{%- endif %}
{%- set requested_sides = [] %}
{%- for side in requested_side_values %}
{%- if side is not string or side not in ['minion', 'master'] %}
{%- do raise("salt-dependency-manager: invalid target_sides value '" ~ side|string ~ "'; expected 'minion' or 'master'") %}
{%- endif %}
{%- if side not in requested_sides %}
{%- do requested_sides.append(side) %}
{%- endif %}
{%- endfor %}

{%- set active_dependencies = [] %}
{%- for dep in dependencies %}
{%- if dep not in active_dependencies %}
{%- for side in dep.sides %}
{%- if side in requested_sides %}
{%- do active_dependencies.append(dep) %}
{%- break %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- set active_local_dependencies = active_dependencies|selectattr('gitfs', 'equalto', False)|list %}

{# Allocate collision-free local state IDs, retaining legacy IDs when unique. #}
{%- set clone_id_bases = [] %}
{%- set duplicate_clone_ids = [] %}
{%- for dep in active_local_dependencies %}
{%- set clone_id_base = 'salt_dependency_manager_clone_' ~ config_id ~ '_' ~ dep.id %}
{%- if clone_id_base in clone_id_bases %}
{%- do duplicate_clone_ids.append(True) %}
{%- endif %}
{%- do clone_id_bases.append(clone_id_base) %}
{%- endfor %}
{%- set clone_records = [] %}
{%- for dep in active_local_dependencies %}
{%- set clone_state_id = clone_id_bases[loop.index0] ~ ('__' ~ loop.index if duplicate_clone_ids else '') %}
{%- do clone_records.append({'dep': dep, 'state_id': clone_state_id}) %}
{%- endfor %}

{%- set base_paths = [] %}
{%- for dep in active_local_dependencies %}
{%- if dep.path not in base_paths %}
{%- do base_paths.append(dep.path) %}
{%- endif %}
{%- endfor %}
{%- set path_id_bases = [] %}
{%- set duplicate_path_ids = [] %}
{%- for path in base_paths %}
{%- set path_id_base = 'salt_dependency_manager_path_' ~ config_id ~ '_' ~ (_id(path)|trim) %}
{%- if path_id_base in path_id_bases %}
{%- do duplicate_path_ids.append(True) %}
{%- endif %}
{%- do path_id_bases.append(path_id_base) %}
{%- endfor %}
{%- set path_records = [] %}
{%- for path in base_paths %}
{%- set path_state_id = path_id_bases[loop.index0] ~ ('__' ~ loop.index if duplicate_path_ids else '') %}
{%- do path_records.append({'path': path, 'state_id': path_state_id}) %}
{%- endfor %}

{%- if not requested_sides %}
salt_dependency_manager_no_dependencies_{{ config_id }}:
  test.nop:
    - name: No dependency sides were selected for {{ config_name or 'this state' }}.
{%- else %}

{%- if active_local_dependencies %}
salt_dependency_manager_git_{{ config_id }}:
  pkg.installed:
    - name: git

{%- for record in path_records %}
{{ record.state_id }}:
  file.directory:
    - name: {{ record.path }}
    - makedirs: True
    - user: root
    - group: root
    - require:
      - pkg: salt_dependency_manager_git_{{ config_id }}

{%- endfor %}
{%- for record in clone_records %}
{%- set dep = record.dep %}
{{ record.state_id }}:
  git.latest:
    - name: {{ dep.url }}
    - target: {{ dep.root }}
    - rev: {{ dep.ref }}
{%- if not dep.update %}
    - unless: test -d {{ dep.root }}/.git
{%- endif %}
{%- for key, value in dep.options.items() %}
    - {{ key }}: {{ value|json }}
{%- endfor %}
    - require:
{%- for path_record in path_records if path_record.path == dep.path %}
      - file: {{ path_record.state_id }}
{%- endfor %}

{%- endfor %}
{%- endif %}

{%- for side in requested_sides %}
salt_dependency_manager_config_dir_{{ config_id }}_{{ side }}:
  file.directory:
    - name: /etc/salt/{{ side }}.d
    - makedirs: True
    - user: root
    - group: root

salt_dependency_manager_config_{{ config_id }}_{{ side }}:
  file.managed:
    - name: /etc/salt/{{ side }}.d/{{ conf_name }}.conf
    - mode: '0644'
    - user: root
    - group: root
    - contents: |
{{ config_for_side(side, active_dependencies, file_roots=file_roots, pillar_roots=pillar_roots)|indent(8, True) }}
    - require:
      - file: salt_dependency_manager_config_dir_{{ config_id }}_{{ side }}
{%- for record in clone_records if side in record.dep.sides %}
      - git: {{ record.state_id }}
{%- endfor %}

{%- endfor %}

{%- endif %}
{%- endmacro %}
